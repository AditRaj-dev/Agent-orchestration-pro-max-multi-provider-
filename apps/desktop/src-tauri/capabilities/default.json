{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the desktop command center",
  "windows": [
    "main",
    "artifact-*"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus"
  ]
}
